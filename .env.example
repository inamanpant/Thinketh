# Copy this file to `.env` and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API.
#
# USE THE "anon public" / "publishable" KEY HERE — NEVER the service role key.
# Everything in a VITE_* variable is shipped to every visitor's browser,
# so a service role key placed here would give anyone full access to your
# database. The anon key is safe to expose; your Row Level Security policies
# are what protect the data.

VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ref"

# The same values without the VITE_ prefix are used by server-side code.
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
